VIDEO_BUCKET_NAME=your-s3-bucket-name
VIDEO_BUCKET_PREFIX=vidframe
CORS_ORIGINS=https://your-domain.com
DATABASE_URL=sqlite:////opt/vidframe/backend/vidframe.db
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_DEDUP_TTL_SECONDS=604800
MAX_UPLOAD_MB=500
UPLOADS_PER_IP_PER_MINUTE=6
UPLOADS_PER_IP_PER_DAY=100
RECAPTCHA_ENABLED=true
RECAPTCHA_SECRET_KEY=your-recaptcha-secret
AWS_REGION=ap-southeast-1

